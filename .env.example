# Optional. When set, Legion uses Neon/Postgres instead of local PGLite.
# DATABASE_URL=postgres://…

# Optional workspace fallbacks. Per-user keys in Settings always win.
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# Auth. Leave unset for local email/password + preview OAuth.
# VITE_AUTH_ENABLED=true
# BETTER_AUTH_URL=http://localhost:8080
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
